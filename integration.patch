+  mobileBarShowSkuPrice, mobileBarSkuPriceDisplay,
+  mobileBarShowProductPromotionPrice, mobileBarProductPromotionPriceDisplay, mobileBarProductPriceDisplay,
+} = useProductDetail({ onLoaded: () => setupMobileBarObserver() })
+
+onUnmounted(() => {
+  if (observer) {
+    observer.disconnect()
+    observer = null
+  }
+})
+</script>
