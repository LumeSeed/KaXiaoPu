+func TestSiteTemplateReadAndSwitch(t *testing.T) {
+	repo := newMockSettingRepo()
+	svc := NewService(repo)
+	repo.store[constants.SettingKeySiteConfig] = map[string]interface{}{
+		constants.SettingFieldStorefrontTemplate: "vault",
+	}
+	data, err := svc.GetConfig(nil)
+	if err != nil || data[constants.SettingFieldStorefrontTemplate] != constants.StorefrontTemplateVault {
+		t.Fatalf("legacy public config: %v, %v", data, err)
+	}
+	if repo.store[constants.SettingKeySiteConfig][constants.SettingFieldStorefrontTemplate] != "vault" {
+		t.Fatal("reading config unexpectedly changed stored settings")
+	}
+	for _, name := range []string{constants.StorefrontTemplateClassic, constants.StorefrontTemplateVault, constants.StorefrontTemplateKaxiaopu} {
+		result, err := svc.UpdateWithEffects(constants.SettingKeySiteConfig, map[string]interface{}{
+			constants.SettingFieldStorefrontTemplate: name,
+		})
+		if err != nil || !result.HasEffect(EffectInvalidatePublicConfigCache) {
+			t.Fatalf("switch %s: %v", name, err)
+		}
+		data, err = svc.GetConfig(nil)
+		if err != nil || data[constants.SettingFieldStorefrontTemplate] != name {
+			t.Fatalf("read after switch %s: %v, %v", name, data, err)
+		}
+	}
+}
