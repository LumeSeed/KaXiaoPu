+  --ink-2: #d6d3d1;
+  --ink-3: #a8a29e;
+  --border: #34312f;
+  --border-strong: #57534e;
+
+  --red: #e7e5e4;
+  --red-strong: #edf3fa;
+  --red-soft: #35312e;
+  --gold: #f6b73c;
+  --gold-strong: #f8c869;
+  --gold-soft: #38320f;
+  --success: #7ad6b0;
+  --warning: #f8c869;
+  --teal: #2dd4bf;
+  --teal-strong: #5ee0d0;
+  --teal-soft: #123230;
+  --plum: #b7c7df;
+  --plum-soft: #2b3542;
+
+  --on-red: #14171b;
+  --on-gold: #202124;
+  --on-teal: #08221f;
+
+  --shadow-sm: 0 2px 8px -3px rgba(0, 0, 0, 0.5);
+  --shadow: 0 16px 32px -18px rgba(0, 0, 0, 0.6);
+  --shadow-lg: 0 28px 54px -22px rgba(0, 0, 0, 0.66);
+  --ring: 0 0 0 4px rgba(99, 102, 241, 0.32);
+}
+
+/* ---------- Base（限定在作用域内） ----------
+   放进 @layer base，确保低于 Tailwind 的 @layer utilities，
+   工具类（text-* / bg-* …）始终可覆盖这些元素 reset。
+   未分层规则会无视优先级压过分层工具类，故此处必须显式分层。 */
+@layer base {
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope h1,
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope h2,
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope h3,
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope h4 {
+    font-family: var(--font-head);
+    font-weight: 700;
+    line-height: 1.1;
+    margin: 0;
+    letter-spacing: -0.015em;
+    color: var(--ink);
+  }
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope p { margin: 0; }
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope a { color: inherit; text-decoration: none; }
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope img,
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope svg { display: block; max-width: 100%; }
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope button { font-family: inherit; cursor: pointer; }
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope ul { margin: 0; }
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope :focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope ::selection { background: var(--gold-soft); color: var(--ink); }
+}
+
+/* ---------- 响应式 / 无障碍 ---------- */
+@media (max-width: 900px) {
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope { --gap-block: 44px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope *,
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope *::before,
+  :where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
