diff --git a/frontend/user/src/components/CatalogCategories.vue b/frontend/user/src/components/CatalogCategories.vue
new file mode 100644
--- /dev/null
+++ b/frontend/user/src/components/CatalogCategories.vue
@@ -0,0 +1,45 @@
+<template>
+  <aside class="catalog-sidebar">
+    <div class="catalog-desktop">
+      <div class="catalog-heading"><Layers class="h-5 w-5" aria-hidden="true" /><div><h2>{{ t('storefront.productCategories') }}</h2><p>{{ t('storefront.categoryCount', { count: count }) }}<template v-if="productCounts[0] !== undefined"> · {{ t('storefront.productCount', { count: productCounts[0] }) }}</template></p></div></div>
+      <CatalogCategoryTree :groups="groups" :counts="productCounts" :selected-category="selectedCategory" :expanded-parent-ids="expandedParentIds" @select="$emit('select', $event)" @toggle="$emit('toggle', $event)" />
+    </div>
+    <DialogRoot v-model:open="open">
+      <DialogTrigger class="catalog-mobile-trigger"><Menu class="h-4 w-4" /><span>{{ t('storefront.productCategories') }}</span><span class="catalog-current">{{ selectedName }}</span><ChevronDown class="h-4 w-4" /></DialogTrigger>
+      <DialogPortal>
+        <DialogOverlay class="catalog-overlay" />
+        <DialogContent class="catalog-sheet" :aria-describedby="undefined">
+          <div class="catalog-sheet-heading"><DialogTitle>{{ t('storefront.productCategories') }}</DialogTitle><DialogClose :aria-label="t('products.closeFilter')"><X class="h-5 w-5" /></DialogClose></div>
+          <CatalogCategoryTree :groups="groups" :counts="productCounts" :selected-category="selectedCategory" :expanded-parent-ids="expandedParentIds" @select="selectMobile" @toggle="$emit('toggle', $event)" />
+        </DialogContent>
+      </DialogPortal>
+    </DialogRoot>
+  </aside>
+</template>
+
+<script setup lang="ts">
+import { computed, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { DialogRoot, DialogTrigger, DialogPortal, DialogOverlay, DialogContent, DialogTitle, DialogClose } from 'reka-ui'
+import { Layers, Menu, ChevronDown, X } from 'lucide-vue-next'
+import CatalogCategoryTree from './CatalogCategoryTree.vue'
+import { useLocalized } from '../composables/useProduct'
+import { useCategoryProductCounts } from '../composables/useCategoryProductCounts'
+import type { CategoryGroup } from '../utils/category'
+const props = withDefaults(defineProps<{ groups: CategoryGroup[]; selectedCategory: number | null; expandedParentIds: number[]; open?: boolean }>(), { open: undefined })
+const emit = defineEmits<{ select: [id: number | null]; toggle: [id: number]; 'update:open': [value: boolean] }>()
+const { t } = useI18n()
+const { getLocalizedText } = useLocalized()
+const productCounts = useCategoryProductCounts(computed(() => props.groups))
+const localOpen = ref(false)
+const open = computed({
+  get: () => props.open ?? localOpen.value,
+  set: (value: boolean) => { localOpen.value = value; emit('update:open', value) },
+})
+const count = computed(() => props.groups.reduce((n, g) => n + 1 + g.children.length, 0))
+const selectedName = computed(() => {
+  const category = props.groups.flatMap(g => [g, ...g.children]).find(g => g.id === props.selectedCategory)
+  return category ? getLocalizedText(category.name) : t('products.allCategories')
+})
+const selectMobile = (id: number | null) => { emit('select', id); open.value = false }
+</script>
diff --git a/frontend/user/src/components/CatalogCategoryTree.vue b/frontend/user/src/components/CatalogCategoryTree.vue
new file mode 100644
--- /dev/null
+++ b/frontend/user/src/components/CatalogCategoryTree.vue
@@ -0,0 +1,57 @@
+<template>
+  <div class="catalog-tree">
+    <label class="catalog-filter"><Search class="h-4 w-4" aria-hidden="true" />
+      <input v-model="filter" type="search" :placeholder="t('storefront.filterCategories')" :aria-label="t('storefront.filterCategories')" />
+    </label>
+    <button class="catalog-category" :class="{ selected: selectedCategory === null }" :aria-pressed="selectedCategory === null" @click="$emit('select', null)">
+      <LayoutGrid class="h-5 w-5" aria-hidden="true" /><span>{{ t('products.allCategories') }}</span>
+      <span v-if="counts[0] !== undefined" class="catalog-count">{{ counts[0] }}</span>
+    </button>
+    <p class="catalog-list-label">{{ t('storefront.categoryList') }}</p>
+    <div v-for="group in filteredGroups" :key="group.id" class="catalog-group">
+      <div class="catalog-category-row" :class="{ selected: selectedCategory === group.id }" @click="$emit('select', group.id)">
+        <button class="catalog-category" :class="{ selected: selectedCategory === group.id }" :aria-pressed="selectedCategory === group.id">
+          <img v-if="group.icon" :src="getImageUrl(group.icon)" alt="" loading="lazy" />
+          <Package v-else class="h-5 w-5" aria-hidden="true" />
+          <span>{{ name(group) }}</span>
+        </button>
+        <button v-if="group.children.length" class="catalog-expand" :aria-label="name(group)" :aria-expanded="isExpanded(group.id)" @click.stop="$emit('toggle', group.id)">
+          <ChevronDown class="h-4 w-4" />
+        </button>
+        <span v-if="counts[group.id] !== undefined" class="catalog-count">{{ counts[group.id] }}</span>
+      </div>
+      <div v-if="isExpanded(group.id)" class="catalog-children">
+        <button v-for="child in group.children" :key="child.id" class="catalog-category" :class="{ selected: selectedCategory === child.id }" :aria-pressed="selectedCategory === child.id" @click="$emit('select', child.id)">
+          <span>{{ name(child) }}</span>
+          <span v-if="counts[child.id] !== undefined" class="catalog-count">{{ counts[child.id] }}</span>
+        </button>
+      </div>
+    </div>
+    <p v-if="!filteredGroups.length" class="p-4 text-sm text-muted-foreground">{{ t('storefront.noCategories') }}</p>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { computed, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { Search, LayoutGrid, Package, ChevronDown } from 'lucide-vue-next'
+import { getImageUrl } from '../utils/image'
+import { useLocalized } from '../composables/useProduct'
+import type { CategoryGroup, PublicCategory } from '../utils/category'
+const props = defineProps<{ groups: CategoryGroup[]; counts: Record<number, number>; selectedCategory: number | null; expandedParentIds: number[] }>()
+defineEmits<{ select: [id: number | null]; toggle: [id: number] }>()
+const { t } = useI18n()
+const { getLocalizedText } = useLocalized()
+const filter = ref('')
+const name = (cat: PublicCategory) => getLocalizedText(cat.name) || cat.slug || ''
+const isExpanded = (id: number) => !!filter.value.trim() || props.expandedParentIds.includes(id)
+const filteredGroups = computed(() => {
+  const q = filter.value.trim().toLocaleLowerCase()
+  if (!q) return props.groups
+  return props.groups.flatMap(group => {
+    if (name(group).toLocaleLowerCase().includes(q)) return [group]
+    const children = group.children.filter(child => name(child).toLocaleLowerCase().includes(q))
+    return children.length ? [{ ...group, children }] : []
+  })
+})
+</script>
diff --git a/frontend/user/src/components/PersonalCenterMobileMenu.vue b/frontend/user/src/components/PersonalCenterMobileMenu.vue
new file mode 100644
--- /dev/null
+++ b/frontend/user/src/components/PersonalCenterMobileMenu.vue
@@ -0,0 +1,52 @@
+<template>
+  <DialogRoot v-model:open="open">
+    <DialogTrigger class="catalog-mobile-trigger">
+      <Menu class="h-4 w-4" aria-hidden="true" />
+      <span>{{ t('storefront.accountMenu') }}</span>
+      <span class="account-menu-current">{{ currentLabel }}</span>
+    </DialogTrigger>
+    <DialogPortal>
+      <DialogOverlay class="catalog-overlay" />
+      <DialogContent class="catalog-sheet" :aria-describedby="undefined">
+        <div class="catalog-sheet-heading">
+          <DialogTitle>{{ t('storefront.accountMenu') }}</DialogTitle>
+          <DialogClose :aria-label="t('storefront.closeMenu')"><X class="h-5 w-5" /></DialogClose>
+        </div>
+        <nav class="catalog-tree" :aria-label="t('storefront.accountMenu')">
+          <button v-for="item in items" :key="item.key" type="button"
+            class="catalog-category" :class="{ selected: currentSection === item.key }"
+            :aria-current="currentSection === item.key ? 'page' : undefined" @click="select(item.key)">
+            <component :is="item.icon" class="h-5 w-5" aria-hidden="true" />
+            <span>{{ t(item.label) }}</span>
+          </button>
+        </nav>
+      </DialogContent>
+    </DialogPortal>
+  </DialogRoot>
+</template>
+
+<script setup lang="ts">
+import { computed, onMounted, onUnmounted, ref, watch } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { DialogRoot, DialogTrigger, DialogPortal, DialogOverlay, DialogContent, DialogTitle, DialogClose } from 'reka-ui'
+import { Menu, X } from 'lucide-vue-next'
+import type { PersonalSection, PersonalSectionItem } from '../composables/usePersonalCenter'
+
+const props = defineProps<{ items: PersonalSectionItem[]; currentSection: PersonalSection }>()
+const emit = defineEmits<{ select: [section: PersonalSection] }>()
+const { t } = useI18n()
+const open = ref(false)
+const currentLabel = computed(() => {
+  const item = props.items.find(item => item.key === props.currentSection)
+  return item ? t(item.label) : ''
+})
+const select = (section: PersonalSection) => { open.value = false; emit('select', section) }
+watch(() => props.currentSection, () => { open.value = false })
+let desktop: MediaQueryList | undefined
+const closeOnDesktop = () => { if (desktop?.matches) open.value = false }
+onMounted(() => {
+  desktop = window.matchMedia('(min-width: 1024px)')
+  desktop.addEventListener('change', closeOnDesktop)
+})
+onUnmounted(() => desktop?.removeEventListener('change', closeOnDesktop))
+</script>
diff --git a/frontend/user/src/components/StorefrontPrice.vue b/frontend/user/src/components/StorefrontPrice.vue
new file mode 100644
--- /dev/null
+++ b/frontend/user/src/components/StorefrontPrice.vue
@@ -0,0 +1,17 @@
+<template>
+  <span class="store-price" :title="currency || siteCurrency"><span class="store-price-currency">{{ symbol }}</span><span class="store-price-amount">{{ formatPrice(amount, '') }}</span></span>
+</template>
+
+<script setup lang="ts">
+import { useLocalized } from '../composables/useProduct'
+import { computed } from 'vue'
+
+const props = defineProps<{ amount: string | number | null | undefined; currency?: string }>()
+const { formatPrice, siteCurrency } = useLocalized()
+const symbol = computed(() => {
+  const currency = props.currency || siteCurrency.value
+  try {
+    return new Intl.NumberFormat('en', { style: 'currency', currency, currencyDisplay: 'narrowSymbol' }).formatToParts(0).find(part => part.type === 'currency')?.value || currency
+  } catch { return currency }
+})
+</script>
diff --git a/frontend/user/src/components/StorefrontProductMeta.vue b/frontend/user/src/components/StorefrontProductMeta.vue
new file mode 100644
--- /dev/null
+++ b/frontend/user/src/components/StorefrontProductMeta.vue
@@ -0,0 +1,28 @@
+<template>
+  <div class="store-product-badges">
+    <span class="store-delivery">{{ getFulfillmentTypeLabel(product.fulfillment_type) }}</span>
+    <span class="store-stock-text" :class="{ 'is-low': product.stock_status === 'low_stock', 'is-out': isSoldOut(product) }">
+      <span>{{ t('quickBuy.stock') }}</span><strong>{{ stockText }}</strong>
+    </span>
+    <span v-if="product.purchase_type !== 'guest'" class="store-purchase-rule">{{ getPurchaseTypeLabel(product.purchase_type) }}</span>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { computed } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { useProductLabels } from '../composables/useProduct'
+
+const props = defineProps<{ product: any }>()
+const { t } = useI18n()
+const { getFulfillmentTypeLabel, getPurchaseTypeLabel, getStockStatusLabel, isSoldOut } = useProductLabels()
+const stockText = computed(() => {
+  const p = props.product
+  if (!isSoldOut(p) && p.stock_status !== 'unlimited' && p.stock_display_mode === 'exact' && p.stock_quantity_hidden !== true) {
+    const raw = p.fulfillment_type === 'auto' ? p.auto_stock_available : p.fulfillment_type === 'manual' ? p.manual_stock_available : undefined
+    const count = Number(raw)
+    if (raw != null && Number.isFinite(count) && count >= 0) return String(Math.floor(count))
+  }
+  return getStockStatusLabel(p)
+})
+</script>
diff --git a/frontend/user/src/components/StorefrontSearch.vue b/frontend/user/src/components/StorefrontSearch.vue
new file mode 100644
--- /dev/null
+++ b/frontend/user/src/components/StorefrontSearch.vue
@@ -0,0 +1,28 @@
+<template>
+  <form class="store-search" role="search" @submit.prevent="submit">
+    <Search class="h-4 w-4 shrink-0" aria-hidden="true" />
+    <input v-model="query" type="search" :aria-label="t('products.searchLabel')"
+      :placeholder="t('storefront.searchProducts')" />
+    <button type="submit" :aria-label="t('products.searchLabel')"><ArrowRight class="h-4 w-4" /></button>
+  </form>
+</template>
+
+<script setup lang="ts">
+import { ref, watch } from 'vue'
+import { useRoute, useRouter } from 'vue-router'
+import { useI18n } from 'vue-i18n'
+import { Search, ArrowRight } from 'lucide-vue-next'
+const route = useRoute()
+const router = useRouter()
+const { t } = useI18n()
+const query = ref('')
+watch(() => route.query.q, value => { query.value = typeof value === 'string' ? value : '' }, { immediate: true })
+const submit = () => {
+  const isCatalog = ['home', 'products', 'category-products'].includes(String(route.name))
+  const nextQuery = isCatalog ? { ...route.query } : {}
+  delete nextQuery.page
+  delete nextQuery.q
+  if (query.value.trim()) nextQuery.q = query.value.trim()
+  return router.push({ path: isCatalog ? route.path : '/products', query: nextQuery })
+}
+</script>
diff --git a/frontend/user/src/composables/useCategoryProductCounts.ts b/frontend/user/src/composables/useCategoryProductCounts.ts
new file mode 100644
--- /dev/null
+++ b/frontend/user/src/composables/useCategoryProductCounts.ts
@@ -0,0 +1,46 @@
+import { ref, watch, type Ref } from 'vue'
+import { productAPI } from '../api/product'
+import type { CategoryGroup } from '../utils/category'
+
+// Public category responses have no counts in v1.5.2. Read pagination totals
+// with one product per request; never infer totals from the visible page.
+const cache = new Map<number, { value: number; expiresAt: number }>()
+const pending = new Map<number, Promise<number | undefined>>()
+
+const getCount = (id: number): Promise<number | undefined> => {
+  const cached = cache.get(id)
+  if (cached && cached.expiresAt > Date.now()) return Promise.resolve(cached.value)
+  const existing = pending.get(id)
+  if (existing) return existing
+  const request = productAPI.list({ page: 1, page_size: 1, ...(id ? { category_id: id } : {}) })
+    .then(response => {
+      const total = response.data.pagination?.total
+      if (typeof total !== 'number' || !Number.isInteger(total) || total < 0) return undefined
+      cache.set(id, { value: total, expiresAt: Date.now() + 60_000 })
+      return total
+    })
+    .catch(() => undefined)
+    .finally(() => pending.delete(id))
+  pending.set(id, request)
+  return request
+}
+
+export function useCategoryProductCounts(groups: Ref<CategoryGroup[]>) {
+  const counts = ref<Record<number, number>>({})
+  watch(() => groups.value.flatMap(group => [group.id, ...group.children.map(child => child.id)]).join(','), async (ids, _, onCleanup) => {
+    let stale = false
+    onCleanup(() => { stale = true })
+    counts.value = {}
+    if (!ids) return
+    // 0 is the unfiltered total, queried separately to avoid double-counting children.
+    const queue = [...new Set([0, ...ids.split(',').map(Number)])]
+    await Promise.all(Array.from({ length: Math.min(4, queue.length) }, async () => {
+      while (queue.length && !stale) {
+        const id = queue.shift()!
+        const count = await getCount(id)
+        if (!stale && count !== undefined) counts.value[id] = count
+      }
+    }))
+  }, { immediate: true })
+  return counts
+}
diff --git a/frontend/user/src/storefront.css b/frontend/user/src/storefront.css
new file mode 100644
--- /dev/null
+++ b/frontend/user/src/storefront.css
@@ -0,0 +1,320 @@
+/* Reference storefront: compact rows, a persistent category rail and quiet surfaces. */
+:root:where([data-storefront-template="kaxiaopu"]) {
+  --ui-bg-page: oklch(0.985 0.002 67.8);
+  --ui-bg-elevated: #fff;
+  --ui-bg-soft: oklch(0.96 0.002 17.2);
+  --ui-bg-muted: #f3f2f1;
+  --ui-text-primary: oklch(0.147 0.004 49.3);
+  --ui-text-secondary: #57534e;
+  --ui-text-muted: oklch(0.547 0.021 43.1);
+  --ui-border: oklch(0.922 0.005 34.3 / .62);
+  --ui-border-strong: #d6d3d1;
+  --ui-accent: oklch(0.214 0.009 43.1);
+  --ui-accent-hover: #35312e;
+  --ui-accent-soft: #e8e7e6;
+  --ui-text-on-accent: #fafaf9;
+  --ui-success: #237447;
+  --ui-success-soft: #dcfce7;
+  --ui-warning: #965b12;
+  --ui-warning-soft: #fef3c7;
+  --ui-focus-ring: rgba(89,111,136,.3);
+  --ui-radius-sm: 8px;
+  --ui-radius-md: 14px;
+  --ui-radius-lg: 16px;
+  --ui-radius-xl: 22px;
+  --ui-shadow-soft: 0 1px 3px #1c191708;
+  --ui-shadow-card: 0 8px 24px -16px #1c191726;
+  --store-dot: rgba(0,0,0,.075);
+  --store-font: KaxiaopuInter, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Segoe UI', system-ui, sans-serif;
+}
+.dark:where([data-storefront-template="kaxiaopu"]) {
+  color-scheme: dark;
+  --store-dot: rgba(255,255,255,.085);
+  --ui-bg-page: #161514;
+  --ui-bg-elevated: #1e1d1c;
+  --ui-bg-soft: #292725;
+  --ui-bg-muted: #222120;
+  --ui-text-primary: #f5f5f4;
+  --ui-text-secondary: #d6d3d1;
+  --ui-text-muted: #a8a29e;
+  --ui-border: #34312f;
+  --ui-border-strong: #57534e;
+  --ui-accent: #e7e5e4;
+  --ui-accent-hover: #fafaf9;
+  --ui-accent-soft: #35312e;
+  --ui-text-on-accent: #1c1917;
+  --ui-success: #86d9a4;
+  --ui-success-soft: #173525;
+  --ui-warning: #facc82;
+  --ui-warning-soft: #392a16;
+}
+html:where([data-storefront-template="kaxiaopu"]) { scroll-padding-top: 88px; }
+:where(html[data-storefront-template="kaxiaopu"]) body { min-width: 320px; }
+:where(html[data-storefront-template="kaxiaopu"]) .storefront-ui { font-family: var(--store-font); line-height: 1.5; -webkit-font-smoothing: antialiased; }
