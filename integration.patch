+  line-height: 1.6;
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+
+/* ---------- Tokens: 暗色（跟随全局 .dark） ---------- */
+.dark:where([data-storefront-template="kaxiaopu"]) .kaxiaopu-scope,
+.dark:where([data-storefront-template="kaxiaopu"]) body.kaxiaopu-tokens {
+  --bg: #161514;
