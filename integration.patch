+/* Vault theme tokens: neutral storefront, with semantic status colours.
+   Tokens also apply to body.kaxiaopu-tokens so teleported dialogs share the theme. */
+
+/* ---------- Tokens: 亮色（默认） ---------- */
+:where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope,
+:where(html[data-storefront-template="kaxiaopu"]) body.kaxiaopu-tokens {
+  --font-head: KaxiaopuInter, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", system-ui, sans-serif;
+  --font-body: KaxiaopuInter, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", system-ui, sans-serif;
+
+  --bg: oklch(0.985 0.002 67.8);
+  --bg-warm: #f3f2f1;
+  --surface: #ffffff;
+  --surface-2: oklch(0.96 0.002 17.2);
+  --ink: oklch(0.147 0.004 49.3);
+  --ink-2: #57534e;
+  --ink-3: oklch(0.547 0.021 43.1);
+  --border: oklch(0.922 0.005 34.3 / .62);
+  --border-strong: #d6d3d1;
+
+  --red: oklch(0.214 0.009 43.1);
+  --red-strong: #363b42;
+  --red-soft: #e8e7e6;
+  --gold: #f59e0b;
+  --gold-strong: #935c12;
+  --gold-soft: #fdf0d7;
+  --teal: #0ea5a4;
+  --teal-strong: #19714f;
+  --teal-soft: #dcfce7;
+  --plum: #586a81;
+  --plum-soft: #e9edf3;
+
+  --on-red: #ffffff;
+  --on-gold: #202124;
+  --on-teal: #ffffff;
+
+  --success: #19714f;
+  --warning: #935c12;
+  --danger: #dc2626;
+
+  --r-sm: 10px;
+  --r: 12px;
+  --r-lg: 16px;
+  --r-xl: 20px;
+  --r-pill: 999px;
+
+  --shadow-sm: 0 2px 8px -3px rgba(33, 26, 23, 0.14);
+  --shadow: 0 14px 30px -18px rgba(33, 26, 23, 0.28);
+  --shadow-lg: 0 26px 50px -24px rgba(33, 26, 23, 0.32);
+  --ring: 0 0 0 4px rgba(79, 70, 229, 0.2);
+
+  --gap-block: 56px;
+  --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
+
+  /* ----------------------------------------------------------------------
+     shadcn --ui-* 覆盖 —— vault 作用域内 shadcn 组件(components/ui/*)与所有
+     标准 utility(bg-primary / bg-card / text-foreground / border-border /
+     rounded-xl …) 自动穿上 vault 皮肤。
+     值用 var(vault token)，因 custom property 惰性求值 + vault 自身 token 已在
+     `.dark .kaxiaopu-scope` 翻转，故此处只写一次，亮/暗自动跟随，暗色块无需重复。
+     ---------------------------------------------------------------------- */
+  --ui-bg-page: var(--bg);
+  --ui-bg-elevated: var(--surface);
+  --ui-bg-soft: var(--surface-2);
+  --ui-bg-muted: var(--bg-warm);
+  --ui-bg-overlay: color-mix(in srgb, var(--surface) 80%, transparent);
+  --ui-bg-overlay-strong: color-mix(in srgb, var(--surface) 92%, transparent);
+  --ui-text-primary: var(--ink);
+  --ui-text-secondary: var(--ink-2);
+  --ui-text-muted: var(--ink-3);
+  --ui-text-on-accent: var(--on-red);
+  --ui-border: var(--border);
+  --ui-border-strong: var(--border-strong);
+  --ui-accent: var(--red);
+  --ui-accent-hover: var(--red-strong);
+  --ui-accent-soft: var(--red-soft);
+  --ui-accent-warm: var(--gold);
+  --ui-accent-warm-hover: var(--gold-strong);
+  --ui-accent-warm-soft: var(--gold-soft);
+  --ui-success: var(--success);
+  --ui-success-soft: var(--teal-soft);
+  --ui-warning: var(--warning);
+  --ui-warning-soft: var(--gold-soft);
+  --ui-danger: var(--danger);
+  --ui-danger-soft: var(--red-soft);
+  --ui-info: var(--teal);
+  --ui-info-soft: var(--teal-soft);
+  --ui-focus-ring: var(--ring);
+  --ui-radius-sm: var(--r-sm);
+  --ui-radius-md: var(--r);
+  --ui-radius-lg: var(--r-lg);
+  --ui-radius-xl: var(--r-xl);
+  --ui-shadow-soft: var(--shadow);
+  --ui-shadow-card: var(--shadow-lg);
+}
+
+/* ---------- 外壳自身的排版与布局（不能挂到 body，否则改掉 body 布局） ---------- */
+:where(html[data-storefront-template="kaxiaopu"]) .kaxiaopu-scope {
+  background: var(--bg);
+  background-image: none;
+  background-size: 20px 20px;
+  color: var(--ink);
